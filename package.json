{
  "name": "cursor-session-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that creates and drives Cursor chat sessions through the window's DevTools port",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
